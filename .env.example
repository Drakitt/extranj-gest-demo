# Plantilla sin secretos. Cópiala a .env y sustituye cada CHANGE_ME.
# No subas el archivo .env. Los comandos de base rechazan estos marcadores
# y cualquier destino que no sea el contenedor local de esta demo.

DATABASE_URL=postgresql://crm_servicios_demo:CHANGE_ME@127.0.0.1:5436/crm_servicios_demo
POSTGRES_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME_USE_AT_LEAST_24_CHARS
SEED_PASSWORD=CHANGE_ME
